rules_version = '2';

// Multi-seat + SUPER TITAN: o tenant é users/{uid} — do dono da conta e de todo mundo
// que tem vínculo em users/{uid}/members/{memberUid} (atendentes convidados).
//
// ESTRUTURA (mudou na auditoria de segurança, não mexa sem ler isto):
// as regras do Firestore são UNIÃO PERMISSIVA — um `match` aninhado mais estrito NÃO
// revoga um `allow` mais amplo que já casou. Por isso NÃO existe mais um
// `match /users/{uid}/{document=**} { allow write }`: enquanto ele existia, era
// impossível restringir papel, exclusão ou formato de campo em qualquer coleção.
// A escrita agora é declarada COLEÇÃO POR COLEÇÃO. Coleção nova sem `match` próprio cai
// no default-deny do fim do arquivo — some da tela até ganhar a sua regra, e isso é de
// propósito: é o único jeito de o silêncio ser seguro.
//
// A leitura continua ampla (um `match` recursivo), mas com uma LISTA DE EXCEÇÕES: o que
// é de gestor para cima não passa por ela, e ganha regra própria mais abaixo.
//
// Os DONOS DO SISTEMA (allowlist de e-mail) NÃO entram no tenant do cliente: os dados de
// atendimento podem ser confidenciais. O que eles têm é (1) ler o DOC users/{uid} para
// listar os clientes e (2) alterar a ficha administrativa desse doc — nome, cor e logo.
// Conversas, mensagens, contatos, faturamento, arquivos e configurações ficam fora do
// alcance deles. As métricas do painel SUPER TITAN são calculadas no servidor pela callable
// `estatisticasClientes`, que devolve só números — não de varrer os dados do cliente daqui.
// A allowlist abaixo deve espelhar src/lib/owners.ts (OWNER_EMAILS).
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Identidade
    // =====================================================================

    function signedIn() { return request.auth != null; }

    // E-mail VERIFICADO. Vale para tudo que é decidido pelo endereço — allowlist de dono
    // do sistema e aceite de convite. Sem isto, quem criasse uma conta com o e-mail de
    // outra pessoa (o Auth não exige prova de caixa postal) herdava o que aquele endereço
    // podia fazer.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    function isSuperOwner() {
      return verified() && request.auth.token.email in [
        'danielboy200627@gmail.com'
        // , 'dono2@exemplo.com'
        // , 'dono3@exemplo.com'
      ];
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid);
    }
    function memberData(uid) { return get(memberPath(uid)).data; }

    // Vínculo de atendente. Custa 1 leitura por avaliação — por isso `owner(uid)` vem
    // sempre ANTES nas condições: o caso comum (dono no próprio tenant) nem chega aqui.
    function isMember(uid) {
      return signedIn() && exists(memberPath(uid)) && memberData(uid).active != false;
    }
    function hasRole(uid, papeis) {
      return isMember(uid) && memberData(uid).role in papeis;
    }

    // Os três níveis, do mais raso ao mais alto. Use SEMPRE estes três — foi a mistura de
    // `isMember`/`isManager` soltos que deixou a exclusão em massa aberta ao atendente.
    function podeVer(uid)   { return owner(uid) || isMember(uid); }
    function podeGerir(uid) { return owner(uid) || hasRole(uid, ['dono', 'gestor']); }
    function ehDono(uid)    { return owner(uid) || hasRole(uid, ['dono']); }

    // =====================================================================
    // Validação de dados
    // =====================================================================

    function novo() { return request.resource.data; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function tocou(campo) { return campo in mudou(); }

    // Responsável e setor precisam EXISTIR no ambiente. Sem isto, um atendente atribuía
    // conversa a um uid inventado e o relatório por atendente virava ficção — e podia
    // esconder o próprio atendimento atrás de um responsável que não existe.
    function membroExiste(uid, memberUid) {
      return memberUid is string && (memberUid == ''
        || exists(/databases/$(database)/documents/users/$(uid)/members/$(memberUid)));
    }
    function setorExiste(uid, sectorId) {
      return sectorId is string && (sectorId == ''
        || exists(/databases/$(database)/documents/users/$(uid)/sectors/$(sectorId)));
    }
    function responsavelOk(uid) {
      return !('assignedTo' in novo()) || membroExiste(uid, novo().assignedTo);
    }
    function setorOk(uid) {
      return !('sectorId' in novo()) || setorExiste(uid, novo().sectorId);
    }
    // O mesmo par, mas dentro do mapa `conv` espelhado no contato.
    function convOk(uid) {
      return !('conv' in novo())
        || ((!('assignedTo' in novo().conv) || membroExiste(uid, novo().conv.assignedTo))
         && (!('sectorId'   in novo().conv) || setorExiste(uid, novo().conv.sectorId)));
    }

    function numeroOk(campo) {
      return !(campo in novo()) || novo()[campo] is number;
    }

    // =====================================================================
    // users/{uid} — o doc do tenant e o doc da conta
    // =====================================================================

    match /users/{uid} {
      // O dono do sistema lê a lista de clientes (nome, cor, logo, e-mail, criação).
      allow read: if podeVer(uid) || isSuperOwner();

      // Config da operação (businessHours, orgName, agent) e as prefs pessoais da conta.
      allow create, update, delete: if ehDono(uid);

      // Ficha administrativa do cliente, editada no painel SUPER TITAN. O hasOnly é a
      // trava de verdade: sem ele, "editar o nome do cliente" viraria escrita livre no
      // doc do tenant (agent, horários, prefs…).
      allow update: if isSuperOwner()
        && mudou().hasOnly(['displayName', 'brandColor', 'logoUrl', 'logoPath']);
    }

    // ---------------------------------------------------------------------
    // A LEITURA também é declarada coleção por coleção — não existe mais um
    // `match /users/{uid}/{document=**} { allow read }`.
    //
    // Não é preciosismo: como as regras são união permissiva, um match amplo de leitura
    // não teria como tirar `invoices`, `knowledge` e `variables` do alcance do atendente.
    // E a tentativa de filtrar por `document[0]` dentro dele não funciona: numa CONSULTA
    // de coleção o curinga `**` não está ligado, e o Firestore recusa a query inteira com
    // "Variable is not bound in path template".
    // ---------------------------------------------------------------------

    // =====================================================================
    // Equipe
    // =====================================================================

    match /users/{uid}/members/{memberUid} {
      allow read: if podeVer(uid);

      // Quem já é dono do ambiente administra a equipe: papel, setores e `active`.
      allow create, update, delete: if ehDono(uid);

      // O CONVIDADO cria o próprio doc (id = uid dele) provando que existe um convite
      // para o e-mail dele apontando para este tenant — o papel tem que ser igual ao do
      // convite, então ninguém se promove no caminho. É o que dispensa uma Cloud Function
      // no aceite.
      //
      // `verified()`: o convite é endereçado a um E-MAIL, e qualquer pessoa pode criar uma
      // conta com o e-mail de outra. Sem a prova de caixa postal, quem adivinhasse o
      // endereço de um convite pendente entrava no tenant no lugar do convidado.
      allow create: if verified()
        && memberUid == request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.tenantUid == uid
        && novo().role == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role
        && novo().keys().hasOnly(['name', 'email', 'role', 'sectorIds', 'active', 'tenantName', 'createdAt'])
        && novo().email == request.auth.token.email
        && novo().active == true;

      // Cada pessoa mantém o PRÓPRIO nome no vínculo — é o que faz o perfil renomeado
      // chegar à lista de atendentes, ao seletor de responsável e aos relatórios. Só o
      // nome: papel, setores e `active` seguem sendo do dono do ambiente, senão um
      // atendente se promoveria sozinho.
      allow update: if signedIn()
        && memberUid == request.auth.uid
        && mudou().hasOnly(['name']);
    }

    // Descoberta de vínculo no login: collectionGroup('members') filtrado pelo próprio
    // e-mail. A condição espelha exatamente o where() da consulta — é o que o Firestore
    // exige para aceitar uma query sobre regra baseada em `resource.data`.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.email == request.auth.token.email;
    }

    // =====================================================================
    // Atendimento — todo membro ativo escreve; APAGAR é de gestor para cima.
    //
    // Separar `delete` foi o ponto: enquanto `write` cobria os três verbos, o papel mais
    // raso do sistema podia esvaziar contatos, negócios e quadros em lote.
    // =====================================================================

    match /users/{uid}/contacts/{contactId} {
      allow read: if podeVer(uid);
      allow create: if podeVer(uid) && convOk(uid)
        && novo().keys().hasOnly([
             'name', 'company', 'initials', 'online', 'role', 'email', 'phone',
             'whatsapp', 'whatsappDigits', 'status', 'nameSource', 'lastMessage',
             'lastMessageAt', 'createdAt', 'unreadCount', 'tagIds', 'conv', 'custom',
             'photoUrl', 'photoPath', 'photoSource', 'optOut',
           ]);
      // No update a lista é de campos ALTERÁVEIS, não do documento inteiro: o daemon
      // grava waJid, historyImport, mediaRecovery e afins pelo Admin SDK, e o cliente não
      // pode encostar neles. `createdAt` fica de fora — data de criação não se reescreve.
      // A ORDEM importa e o `tocou` não é enfeite. `hasOnly` é a checagem barata — nenhuma
      // leitura — e vem primeiro para short-circuitar quando o conjunto de campos já está
      // errado. E `convOk` só roda quando `conv` REALMENTE muda: `novo()` é o documento
      // resultante inteiro, então todo contato que já teve conversa sempre tem `conv`, e
      // validar sem o `tocou` gastava duas buscas em toda troca de `lastMessage` — que é o
      // caminho mais quente do app.
      allow update: if mudou().hasOnly([
             'name', 'company', 'initials', 'role', 'email', 'phone', 'whatsapp',
             'whatsappDigits', 'nameSource', 'unreadCount', 'lastMessage', 'lastMessageAt',
             'tagIds', 'conv', 'custom', 'photoUrl', 'photoPath', 'photoSource', 'optOut',
           ])
        && podeVer(uid)
        && (!tocou('conv') || convOk(uid));
      allow delete: if podeGerir(uid);
    }

    // Mensagens e arquivos do contato — nomeados UM A UM, nunca com `{sub=**}`.
    //
    // O curinga recursivo casa também com ZERO segmentos, ou seja, com o próprio doc do
    // contato: um `match .../contacts/{id}/{sub=**}` com `allow update` livre devolveria
    // ao contato a escrita sem validação que a regra de cima acabou de restringir, e o
    // `createdAt` voltaria a ser reescrevível. União permissiva de novo.
    match /users/{uid}/contacts/{contactId}/messages/{msgId} {
      allow read: if podeVer(uid);
      allow create, update: if podeVer(uid);
      allow delete: if podeGerir(uid);
    }
    match /users/{uid}/contacts/{contactId}/files/{fileId} {
      allow read: if podeVer(uid);
      allow create, update: if podeVer(uid);
      allow delete: if podeGerir(uid);
    }

    match /users/{uid}/conversations/{recordId} {
      allow read: if podeVer(uid);
      allow create: if podeVer(uid) && responsavelOk(uid) && setorOk(uid)
        && novo().keys().hasOnly([
             'contactId', 'contactName', 'assignedTo', 'assignedName', 'sectorId',
             'tagIds', 'openedAt', 'firstResponseAt', 'closedAt', 'closedBy',
           ]);
      // Mesmo motivo do contato: `markFirstResponse` só toca `firstResponseAt`, e sem o
      // `tocou` pagava duas buscas para revalidar responsável e setor que não mudaram.
      allow update: if mudou().hasOnly([
             'contactName', 'assignedTo', 'assignedName', 'sectorId', 'tagIds',
             'firstResponseAt', 'closedAt', 'closedBy',
           ])
        && podeVer(uid)
        && (!tocou('assignedTo') || responsavelOk(uid))
        && (!tocou('sectorId') || setorOk(uid));
      allow delete: if podeGerir(uid);
    }

    match /users/{uid}/deals/{dealId} {
      allow read: if podeVer(uid);
      allow create: if podeVer(uid) && numeroOk('value') && numeroOk('order')
        && novo().keys().hasOnly([
             'company', 'contact', 'value', 'initials', 'tag', 'contactId',
             'boardId', 'columnId', 'order', 'createdAt', 'reachedAt',
           ]);
      allow update: if podeVer(uid) && numeroOk('value') && numeroOk('order')
        && mudou().hasOnly([
             'company', 'contact', 'value', 'initials', 'tag', 'contactId',
             'boardId', 'columnId', 'order', 'reachedAt',
           ]);
      allow delete: if podeGerir(uid);
    }

    // Quadros, atividades, agenda, agendamentos, fluxos e o chat do Titã IA.
    // Sem lista de campos: o formato varia (o quadro guarda `columns`, o fluxo guarda
    // `nodes`/`edges`) e travar isso aqui quebraria a tela sem ganho de segurança —
    // nenhum desses campos decide permissão.
    match /users/{uid}/boards/{id}            { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    match /users/{uid}/activities/{id}        { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    match /users/{uid}/events/{id}            { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    match /users/{uid}/scheduledMessages/{id} { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    match /users/{uid}/flows/{id}             { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    match /users/{uid}/leads/{id}             { allow read: if podeVer(uid); allow create, update: if podeVer(uid); allow delete: if podeGerir(uid); }
    // O chat do agente é conversa da pessoa com a IA: quem escreve também limpa.
    match /users/{uid}/agentChat/{id}         { allow read, create, update, delete: if podeVer(uid); }

    // =====================================================================
    // Módulos de gestor
    // =====================================================================

    match /users/{uid}/invoices/{id} {
      allow read: if podeGerir(uid);
      allow create, update: if podeGerir(uid)
        && numeroOk('value')
        && (!('status' in novo()) || novo().status in ['Paga', 'Pendente', 'Vencida']);
      allow delete: if podeGerir(uid);
    }

    match /users/{uid}/campaigns/{id}          { allow read: if podeVer(uid); allow write: if podeGerir(uid); }
    match /users/{uid}/campaigns/{id}/targets/{targetId} { allow read: if podeVer(uid); allow write: if podeGerir(uid); }

    // =====================================================================
    // Configurações — só o dono do ambiente
    //
    // O gestor CONSULTA (pela leitura ampla lá em cima) e administra o atendimento, mas
    // não altera setores, etiquetas, campos e afins.
    // =====================================================================

    match /users/{uid}/sectors/{id}       { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/tags/{id}          { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/quickReplies/{id}  { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/customFields/{id}  { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/actTypes/{id}      { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/mediaLibrary/{id}  { allow read: if podeVer(uid); allow write: if ehDono(uid); }

    // Conteúdo que alimenta a IA e as respostas rápidas. TODO MEMBRO LÊ, só o dono escreve.
    //
    // A primeira versão desta auditoria restringiu a leitura a gestor, junto com `invoices`,
    // e isso estava errado: o atendente PRECISA de `variables` para as respostas rápidas
    // substituírem nome, empresa e afins (src/pages/Contacts.tsx usa `variableMap`), e
    // `knowledge` alimenta o Titã IA, que ele tem permissão de usar. Esconder qualquer um
    // dos dois de quem já lê todas as conversas do ambiente não protege nada — só quebra o
    // uso diário, e quebra CALADO, porque `useCollection` engole o erro e devolve lista
    // vazia. Quem tem valor de segregação aqui é `invoices`, que segue em `podeGerir`.
    match /users/{uid}/variables/{id} { allow read: if podeVer(uid); allow write: if ehDono(uid); }
    match /users/{uid}/knowledge/{id} { allow read: if podeVer(uid); allow write: if ehDono(uid); }

    // =====================================================================
    // Convites
    // =====================================================================

    match /invites/{email} {
      // O convidado lê e apaga o próprio convite (ao aceitar).
      allow read, delete: if signedIn() && email == request.auth.token.email;

      // Quem convida enxerga os pendentes do próprio tenant. `podeGerir(resource.data
      // .tenantUid)` custa uma leitura por documento retornado, e é o que faz a tela de
      // Equipe funcionar para o GESTOR — antes a condição era só
      // `tenantUid == request.auth.uid`, que só casava com o titular da conta: o gestor
      // criava e cancelava convites que nunca conseguia listar.
      allow read: if signedIn() && podeGerir(resource.data.tenantUid);
      allow update, delete: if signedIn() && podeGerir(resource.data.tenantUid);

      // O papel é a parte perigosa: o convite vira o vínculo lá em members, então quem
      // pode escolher `dono` aqui pode fabricar um dono do ambiente. Gestor convida
      // atendente e gestor; só o dono do ambiente convida outro dono.
      allow create: if signedIn()
        && podeGerir(novo().tenantUid)
        && novo().role in ['atendente', 'gestor', 'dono']
        && (novo().role != 'dono' || ehDono(novo().tenantUid))
        && novo().email == email
        && novo().keys().hasOnly(['email', 'tenantUid', 'tenantName', 'role', 'sectorIds', 'createdAt']);
    }

    // =====================================================================
    // WhatsApp
    // =====================================================================

    // Status da conexão (QR + estado). Cliente LÊ o próprio; NUNCA escreve (quem escreve
    // é o daemon via Admin SDK).
    match /whatsappStatus/{uid} {
      // Qualquer membro ativo do ambiente lê: o número é o da empresa, e a sessão é uma só
      // para toda a operação — sem isto o atendente nunca via o QR nem o estado da conexão,
      // porque a tela observa whatsappStatus/{tenant}, não o uid dele.
      allow read: if podeVer(uid);
      allow write: if false;
    }

    // FILA DE COMANDOS DO DAEMON.
    //
    // Vive numa coleção de TOPO, e não em users/{uid}/waCommands, por um motivo de
    // segurança e não de organização: lá dentro ela era alcançada pela regra ampla de
    // escrita do tenant, e como regra do Firestore é união permissiva, nenhuma condição
    // aninhada conseguia impedir um ATENDENTE de enfileirar `contact.purge` ou
    // `session.disconnect` — comandos que o daemon executa com Admin SDK e que apagam
    // contatos, mensagens e mídias sem volta. Aqui a fila tem regra própria e o tipo do
    // comando decide o papel exigido.
    match /waCommands/{tenantUid}/queue/{cmdId} {
      function tipo() { return novo().type; }
      function tipoValido() {
        return tipo() in [
          'session.consent', 'session.connect', 'session.disconnect',
          'message.send', 'message.sendMedia', 'history.fetch',
          'contact.purge', 'contact.photoRefresh', 'contact.mediaRetry'
        ];
      }
      // Desconectar derruba o WhatsApp da empresa inteira; purgar apaga sem volta;
      // o consentimento define a retenção LGPD do ambiente. Nada disso é do atendente.
      function tipoDeGestor() {
        return tipo() in ['contact.purge', 'session.disconnect', 'session.consent'];
      }

      allow read: if podeVer(tenantUid);

      allow create: if podeVer(tenantUid)
        && tipoValido()
        && (!tipoDeGestor() || podeGerir(tenantUid))
        // `by` amarra o comando a quem o pediu. O daemon confere o papel de novo antes de
        // executar — a regra sozinha não basta, porque o Admin SDK ignora regra.
        && novo().by == request.auth.uid
        && novo().status == 'pending'
        && novo().attempts == 0
        && novo().keys().hasOnly(['type', 'args', 'status', 'attempts', 'createdAt', 'expireAt', 'by']);

      // Quem avança o status é o daemon. Pelo navegador só se CANCELA o que ainda não
      // rodou — sem isto dava para marcar como concluído um comando nunca executado.
      allow update: if podeVer(tenantUid)
        && resource.data.status == 'pending'
        && mudou().hasOnly(['status'])
        && novo().status == 'canceled';

      allow delete: if podeGerir(tenantUid)
        || (podeVer(tenantUid) && resource.data.by == request.auth.uid);
    }

    // NOTA: as credenciais/chaves do Signal ficam em whatsappSessions/** — deliberadamente
    // SEM nenhuma regra aqui, então caem no default-deny abaixo (só o Admin SDK acessa).

    // Sinal de vida do daemon self-hosted. O cliente lê para saber se há alguém do outro
    // lado da fila antes de esperar por um comando que ninguém vai atender.
    match /whatsappDaemon/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Nega tudo o que não casar acima — inclusive coleção nova que ainda não ganhou regra.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
