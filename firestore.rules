rules_version = '2';

// Multi-seat + SUPER TITAN: o tenant é users/{uid} — do dono da conta e de todo mundo
// que tem vínculo em users/{uid}/members/{memberUid} (atendentes convidados).
//
// Os DONOS DO SISTEMA (allowlist de e-mail) NÃO entram no tenant do cliente: os dados de
// atendimento podem ser confidenciais. O que eles têm é (1) ler o DOC users/{uid} para
// listar os clientes, (2) alterar só a ficha administrativa desse doc — nome, cor e logo —
// e (3) as consultas de grupo agregadas dos dashboards. Conversas, mensagens, arquivos e
// configurações ficam fora do alcance deles.
// A allowlist abaixo deve espelhar src/lib/owners.ts (OWNER_EMAILS).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isSuperOwner() {
      return signedIn() && request.auth.token.email in [
        'danielboy200627@gmail.com'
        // , 'dono2@exemplo.com'
        // , 'dono3@exemplo.com'
      ];
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid);
    }
    // Vínculo de atendente. Custa 1 leitura por avaliação — por isso `owner(uid)` vem
    // sempre ANTES nas condições: o caso comum (dono no próprio tenant) nem chega aqui.
    function isMember(uid) {
      return signedIn() && exists(memberPath(uid))
        && get(memberPath(uid)).data.active != false;
    }
    function isManager(uid) {
      return isMember(uid) && get(memberPath(uid)).data.role in ['dono', 'gestor'];
    }

    // Coleções que um ATENDENTE (papel mais raso) pode escrever. O que fica de fora —
    // members, sectors, tags, quickReplies, customFields, actTypes, invoices — é de
    // gestor para cima. Precisa ser decidido AQUI, dentro da própria regra ampla:
    // as regras do Firestore são união permissiva, então um `allow write: if false`
    // aninhado não revogaria nada.
    function agentWritable(seg) {
      return seg in [
        'contacts', 'conversations', 'deals', 'boards', 'activities', 'events',
        'scheduledMessages', 'leads', 'flows', 'waCommands', 'agentMessages'
      ];
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(request.auth.token.email);
    }

    match /users/{uid} {
      allow read: if owner(uid) || isMember(uid) || isSuperOwner();
      allow write: if owner(uid) || isManager(uid);

      // Ficha administrativa do cliente, editada no painel SUPER TITAN. O hasOnly é a
      // trava de verdade: sem ele, "editar o nome do cliente" viraria escrita livre no
      // doc do tenant (agent, horários, prefs…).
      allow update: if isSuperOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'brandColor', 'logoUrl', 'logoPath']);

      // O vínculo em si: quem já é gestor administra a equipe. O CONVIDADO cria o
      // próprio doc (id = uid dele) provando que existe um convite para o e-mail dele
      // apontando para este tenant — o papel tem que ser igual ao do convite, então
      // ninguém se promove no caminho. É o que dispensa uma Cloud Function no aceite.
      match /members/{memberUid} {
        allow read: if owner(uid) || isMember(uid);
        allow write: if owner(uid) || isManager(uid);
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && exists(invitePath())
          && get(invitePath()).data.tenantUid == uid
          && request.resource.data.role == get(invitePath()).data.role;
      }

      match /{document=**} {
        allow read: if owner(uid) || isMember(uid);
        allow write: if owner(uid) || isManager(uid)
          || (isMember(uid) && agentWritable(document[0]));
      }
    }

    // Descoberta de vínculo no login: collectionGroup('members') filtrado pelo próprio
    // e-mail. A condição espelha exatamente o where() da consulta — é o que o Firestore
    // exige para aceitar uma query sobre regra baseada em `resource.data`.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.email == request.auth.token.email;
    }

    // Convites. O doc é chaveado pelo e-mail do convidado: ele lê e apaga o próprio
    // convite (ao aceitar); quem convida é gestor do tenant apontado no doc.
    //
    // A leitura de quem CONVIDA é só `resource.data.tenantUid == request.auth.uid`, de
    // propósito: a tela lista os pendentes com where('tenantUid','==',uid), e o Firestore
    // só aceita uma consulta quando consegue casar o filtro com a condição da regra.
    // Um `get()` de papel aqui dentro não é comparável a um where(), e derrubaria a
    // listagem inteira — a escrita, que é doc a doc, pode ser mais rica.
    match /invites/{email} {
      allow read, delete: if signedIn() && email == request.auth.token.email;
      allow read: if signedIn() && resource.data.tenantUid == request.auth.uid;
      allow update, delete: if signedIn()
        && (owner(resource.data.tenantUid) || isManager(resource.data.tenantUid));
      allow create: if signedIn()
        && (owner(request.resource.data.tenantUid) || isManager(request.resource.data.tenantUid));
    }

    // Leituras agregadas (collectionGroup) para os dashboards SUPER TITAN — só donos, e só
    // o que o useOwnerStats realmente consome: pipeline, faturamento e as contagens de
    // contatos e atividades. `conversations` e `messages` NÃO entram aqui de propósito —
    // é o conteúdo do atendimento, e nenhum dashboard precisa dele.
    //
    // `list`, e não `read`: assim vale para a consulta de grupo que alimenta os números e
    // NÃO para um `get` direto em users/{cliente}/contacts/{id} — que seria abrir a ficha
    // de um contato específico do cliente pelo caminho, exatamente o que não pode.
    match /{path=**}/deals/{id}      { allow list: if isSuperOwner(); }
    match /{path=**}/invoices/{id}   { allow list: if isSuperOwner(); }
    match /{path=**}/contacts/{id}   { allow list: if isSuperOwner(); }
    match /{path=**}/activities/{id} { allow list: if isSuperOwner(); }

    // Status da conexão de WhatsApp (QR + estado). Cliente LÊ o próprio; NUNCA escreve
    // (quem escreve é o daemon via Admin SDK). Coleção top-level de propósito, para o
    // read-only ser limpo — regras do Firestore são UNIÃO permissiva, então um write:false
    // aninhado sob users/{uid}/{document=**} não revogaria o owner-write recursivo.
    match /whatsappStatus/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    // NOTA: as credenciais/chaves do Signal ficam em whatsappSessions/** — deliberadamente
    // SEM nenhuma regra aqui, então caem no default-deny abaixo (só o Admin SDK acessa).

    // Sinal de vida do daemon self-hosted. O cliente lê para saber se há alguém do outro
    // lado da fila (users/{uid}/waCommands) antes de esperar por um comando que ninguém
    // vai atender. Doc global e sem dado de tenant — por isso basta estar autenticado.
    match /whatsappDaemon/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // NOTA: a fila de comandos vive em users/{uid}/waCommands/{id} e já é coberta pelo
    // `allow write: if owner(uid)` recursivo acima. Como as regras são UNIÃO permissiva,
    // NÃO é possível restringir aqui o schema/volume do que é enfileirado — essa validação
    // (whitelist de `type`, cap de args, rate-limit) é feita no daemon, em actions.ts.

    // Nega tudo o que não casar acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
